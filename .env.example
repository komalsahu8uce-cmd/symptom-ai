# Copy this file to a new file named ".env" (same folder) and fill in the values.
# NEVER upload the ".env" file to GitHub. It holds your secret key.

# Your xAI API key. Create one at https://console.x.ai/
XAI_API_KEY=paste-your-xai-key-here

# Which Grok model the agents use.
XAI_MODEL_NAME=grok-4.7

# Set to true to test the app WITHOUT an API key (uses fake sample answers).
DEMO_MODE=false

# Optional password for your pilot users. Leave empty for no password.
# Strongly recommended once the site is public so strangers cannot use up your API credit.
ACCESS_CODE=

# Max number of analyses one person (IP address) can run per hour.
RATE_LIMIT_PER_HOUR=8
